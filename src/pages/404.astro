---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="404 — Page Not Found" description="This page doesn't exist." />
		<style>
			main {
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				min-height: 60vh;
				text-align: center;
				padding: 2rem;
			}
			.code {
				font-size: 6rem;
				font-weight: 700;
				line-height: 1;
				color: rgb(var(--accent));
				margin: 0;
			}
			.message {
				font-size: 1.75rem;
				font-weight: 700;
				color: rgb(var(--black));
				margin: 1.5rem 0 2rem;
				max-width: 480px;
				line-height: 1.3;
			}
			a.home-link {
				color: rgb(var(--accent));
				text-decoration: underline;
				font-weight: 600;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<p class="code">404</p>
			<p class="message">If you ever thought you were lost, now it's the time.</p>
<p><a class="home-link" href="/">← Back to home</a></p>
		</main>
		<Footer />
	</body>
</html>
