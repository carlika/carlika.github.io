a---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import avatar from '../assets/avatar.jpg';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="hero-text">
					<h1>DevOps notes<br />from the trenches.</h1>
					<p class="lead">
						Hi, I'm Filip — a DevOps engineer based in Croatia. CKA certified.
						Co-founder of <a href="https://gedor.ai" target="_blank">gedor.ai</a> and
						founder of <a href="https://progrex.dev" target="_blank">Progrex</a>.
					</p>
					<p>
						I write about Kubernetes, CI/CD pipelines, container security, infrastructure-as-code,
						and the things that quietly break in production. Practical, reproducible, no fluff.
					</p>
					<a href="/blog" class="cta">Read the blog &rarr;</a>
				</div>
				<div class="hero-avatar">
					<Image src={avatar} alt="Filip Corluka" width={160} height={280} />
				</div>
			</section>
			<section class="topics">
				<h2>Topics</h2>
				<ul class="tag-list">
					<li>Kubernetes</li>
					<li>CI/CD</li>
					<li>Container Security</li>
					<li>Terraform</li>
					<li>Observability</li>
					<li>Supply Chain</li>
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
<style>
	main {
		max-width: 720px;
		margin: 0 auto;
		padding: 3em 1em;
	}
	.hero {
		display: flex;
		align-items: flex-start;
		gap: 2.5em;
	}
	.hero-avatar {
		padding-top: 15%;
	}
	.hero-text {
		flex: 1;
	}
	.hero-avatar img {
		width: 160px;
		height: 160px;
		border-radius: 50%;
		object-fit: cover;
		object-position: center 15%;
		box-shadow: var(--box-shadow);
	}
	.hero h1 {
		font-size: 3em;
		line-height: 1.15;
		margin-bottom: 0.5em;
	}
	.lead {
		font-size: 1.15em;
		color: rgb(var(--gray-dark));
	}
	.cta {
		display: inline-block;
		margin-top: 1.5em;
		padding: 0.6em 1.4em;
		background: var(--accent);
		color: white;
		border-radius: 6px;
		text-decoration: none;
		font-weight: 700;
		font-size: 0.95em;
		transition: background 0.15s;
	}
	.cta:hover {
		background: var(--accent-dark);
	}
	.topics {
		margin-top: 3.5em;
		padding-top: 2em;
		border-top: 1px solid rgb(var(--gray-light));
	}
	.topics h2 {
		font-size: 0.85em;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: rgb(var(--gray));
		margin-bottom: 1em;
	}
	.tag-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em;
	}
	.tag-list li {
		padding: 0.3em 0.8em;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 999px;
		font-size: 0.85em;
		color: rgb(var(--gray-dark));
	}
	@media (max-width: 720px) {
		.hero {
			flex-direction: column-reverse;
			align-items: center;
			text-align: center;
		}
		.hero-avatar img {
			width: 120px;
			height: 120px;
		}
	}
</style>
